# Exact Moodle origin, without a trailing slash.
VIZCODE_MOODLE_ORIGIN=https://moodle.example.edu
# Generate two independent 64-character random hex secrets. Do not use these placeholders.
VIZCODE_JAVA_KEY=REPLACE_WITH_RANDOM_SECRET
VIZCODE_SUPERVISOR_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
# Optional rootless-Docker socket path (the supervisor must be able to access it).
VIZCODE_DOCKER_SOCKET=/var/run/docker.sock
