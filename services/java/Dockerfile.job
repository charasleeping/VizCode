FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openjdk-21-jdk-headless && rm -rf /var/lib/apt/lists/*
COPY VizTrace.java /opt/vizcode/VizTrace.java
RUN javac --release 21 --add-modules jdk.jdi,jdk.compiler -d /opt/vizcode /opt/vizcode/VizTrace.java
USER 10001:10001
ENTRYPOINT ["java","-Xmx160m","-XX:+UseSerialGC","-XX:ActiveProcessorCount=1","--add-modules","jdk.jdi,jdk.compiler","-cp","/opt/vizcode","VizTrace"]
