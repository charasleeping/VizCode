FROM node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && python3 -m venv /opt/debugpy && /opt/debugpy/bin/pip install --no-cache-dir debugpy==1.8.17 && rm -rf /var/lib/apt/lists/*
COPY dap.mjs dap-run.mjs debugpy-profile.json /opt/vizcode/
USER 10001:10001
ENTRYPOINT ["node","/opt/vizcode/dap-run.mjs","/opt/vizcode/debugpy-profile.json"]
